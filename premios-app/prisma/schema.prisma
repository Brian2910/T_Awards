generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  votes Vote[]
}

enum CategoryType {
  TEXT
  PHOTO
  AUDIO
}

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        CategoryType
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  votes Vote[]
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  textAnswer String?
  fileUrl    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  // Un usuario solo puede votar una vez por categoría
  @@unique([userId, categoryId])
}
