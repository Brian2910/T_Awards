generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  image     String?
  points    Int      @default(0)
  createdAt DateTime @default(now())

  votes             Vote[]
  pointTransactions PointTransaction[]
}

enum CategoryType {
  TEXT
  TEXT3
  PHOTO
  AUDIO
}

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        CategoryType
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  votes Vote[]
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  textAnswer String?
  textAnswer2 String?
  textAnswer3 String?
  fileUrl    String?
  createdAt  DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  // Un usuario solo puede votar una vez por categoría
  @@unique([userId, categoryId])
}

model Game {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  transactions PointTransaction[]
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  gameId    String?
  points    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id])
}
